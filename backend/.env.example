# Phase 1
APP_NAME=DeployFlow
ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Phase 2 — PostgreSQL
DATABASE_URL=postgresql+asyncpg://deployflow:deployflow@localhost:5433/deployflow
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Phase 3 — Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-secret-change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
