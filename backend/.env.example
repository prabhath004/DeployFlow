# Phase 1
APP_NAME=DeployFlow
ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Phase 2 — PostgreSQL
DATABASE_URL=postgresql+asyncpg://deployflow:deployflow@localhost:5433/deployflow
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Phase 3 — Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-secret-change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Phase 5 — Redis
REDIS_URL=redis://localhost:6380/0
CACHE_DEPLOYMENT_STATUS_TTL=10
CACHE_PROJECT_METADATA_TTL=60
CACHE_DASHBOARD_SUMMARY_TTL=30
RATE_LIMIT_DEPLOY_PER_MINUTE=10
WORKER_HEARTBEAT_TTL=30

# Phase 8 — Queue backend
QUEUE_BACKEND=redis
# When QUEUE_BACKEND=sqs, set:
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://localhost:4566           # LocalStack only
# AWS_ACCESS_KEY_ID=test                            # LocalStack only
# AWS_SECRET_ACCESS_KEY=test                        # LocalStack only
# SQS_QUEUE_URL=http://localhost:4566/000000000000/deployflow-deployments
# SQS_DLQ_URL=http://localhost:4566/000000000000/deployflow-deployments-dlq
# SQS_VISIBILITY_TIMEOUT=60
# SQS_WAIT_TIME_SECONDS=20

# Phase 9 — S3 + ECR
ARTIFACTS_BACKEND=none
# When ARTIFACTS_BACKEND=s3, set:
# S3_ARTIFACTS_BUCKET=deployflow-artifacts
# S3_ARTIFACTS_PREFIX=deployments/
# ECR_REPOSITORY_URI=123456789012.dkr.ecr.us-east-1.amazonaws.com/deployflow
